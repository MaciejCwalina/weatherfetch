def describe(weather_code, is_daytime=True):
    description, art_key, color = WEATHER_CODES.get(
        weather_code, ("Unknown", "cloud", (156, 163, 175)))
    if art_key == "sun" and not is_daytime:
        return description.replace("Clear sky", "Clear night"), "moon", (203, 213, 225)
    return description, art_key, color


