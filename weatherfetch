#!/usr/bin/env python3
"""weatherfetch - a fastfetch-style weather report for your terminal.

No API keys, no dependencies. Geolocation via IP (or pass a city name),
weather via Open-Meteo.
"""

import argparse
import json
import os
import re
import sys
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime

REQUEST_TIMEOUT = 8
USER_AGENT = {"User-Agent": "weatherfetch/1.0"}

# ---------------------------------------------------------------- colors

ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")


class Palette:
    """Truecolor palette. Neutralized to empty strings when color is off."""

    reset = "\x1b[0m"
    bold = "\x1b[1m"
    dim = "\x1b[2m"

    @staticmethod
    def foreground(red, green, blue):
        return f"\x1b[38;2;{red};{green};{blue}m"

    accent = ""      # set at runtime from the weather condition
    label = ""
    value = ""
    muted = ""


COLOR_ENABLED = True


def disable_color():
    global COLOR_ENABLED
    COLOR_ENABLED = False
    Palette.reset = Palette.bold = Palette.dim = ""
    Palette.foreground = staticmethod(lambda red, green, blue: "")


def visible_width(text):
    return len(ANSI_PATTERN.sub("", text))


